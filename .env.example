# Copy this file to .env and set a password for each variable before running Docker Compose.
# .env is ignored by Git. Never commit real passwords.

BUGGY_POSTGRES_ADMIN_PASSWORD=
BUGGY_ACCOUNT_DB_PASSWORD=
BUGGY_CATALOG_DB_PASSWORD=
BUGGY_ORDER_DB_PASSWORD=
BUGGY_PAYMENT_DB_PASSWORD=
BUGGY_LOGISTICS_DB_PASSWORD=

# Optional: host port for PostgreSQL (default 5433).
# BUGGY_POSTGRES_PORT=5433
